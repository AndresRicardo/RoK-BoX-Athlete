# ============================================================
# CONFIGURACIÓN DEL AGENTE DE SINCRONIZACIÓN HIKCENTRAL -> SUPABASE
# Copiar este archivo como .env en esta misma carpeta y llenar los datos
# ============================================================

# Supabase (Tu proyecto en la nube o autohospedado)
SUPABASE_URL=https://qsqrnfgcozvznkbdyozs.supabase.co
# NOTA: Usar SERVICE_ROLE_KEY (no anon key) para permitir actualizar sin sesión de usuario
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# Intervalo de sincronización en minutos (Recomendado: 5)
SYNC_INTERVAL_MINUTES=5

# Modo de conexión con HikCentral: "openapi" o "direct_db" o "csv_watch"
HIKCENTRAL_MODE=openapi

# --- OPCIÓN A: HIKCENTRAL OPENAPI (Recomendado si está habilitada la OpenAPI) ---
HIKCENTRAL_HOST=127.0.0.1
HIKCENTRAL_PORT=443
HIKCENTRAL_APP_KEY=tu_app_key_hikcentral
HIKCENTRAL_APP_SECRET=tu_app_secret_hikcentral

# --- OPCIÓN B: BASE DE DATOS LOCAL DE HIKCENTRAL (SQL Server o PostgreSQL) ---
HIK_DB_TYPE=mssql
HIK_DB_HOST=127.0.0.1
HIK_DB_PORT=1433
HIK_DB_NAME=HikCentral_Access
HIK_DB_USER=sa
HIK_DB_PASSWORD=tu_password_db
